# Slack token — read-only scopes only:
# channels:read, groups:read, im:read, mpim:read, users:read, search:read
SLACK_TOKEN=xoxp-your-token-here

# Optional: limit deep reads per run (default 10)
MAX_DEEP_READS=10

# Optional: only consider messages newer than this many hours (default 24)
LOOKBACK_HOURS=24
